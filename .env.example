# OpenClawd Solana Kit — copy to .env or src/.env.local
#   cp .env.example .env
#   # or: cp .env.example src/.env.local
# Docs: docs/configuration.md · docs/authentication.md · docs/http_service.md

# --- Required for local / example agents ---
ANTHROPIC_API_KEY=

# Local Solana signing (examples only — do NOT use on multi-user HTTP)
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Required for HTTP service: cargo run --features full --bin kit ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Single-line PEM with escaped newlines:
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Optional: paper perps context (docs/perps.md; tools not in default agent yet) ---
PERPS_MODE=paper
PERPS_MARKET=SOL-PERP
# PHOENIX_PERPS_URL=
# RISE_PERPS_URL=

# --- Optional: constitution / automation ---
# CLAWD_ENV_FILE=/absolute/path/to/custom.env
# CLAWD_CONSTITUTION_PATH=
# CLAWD_RULES_PATH=
# CLAWD_KIT_ROOT=
# CLAWD_LOCAL=1
# CLAWD_SKIP_START=1
