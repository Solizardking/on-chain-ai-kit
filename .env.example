# OpenClawd Solana Kit
#   cp .env.example .env
#   # or: cp .env.example src/.env.local
# Docs: docs/configuration.md · docs/http_service.md

# --- Auth mode ---
# local  = default, no Privy, signs with SOLANA_PRIVATE_KEY (dev only)
# privy  = multi-user JWT + delegated wallets
KIT_AUTH_MODE=local

# --- Required for local HTTP + examples ---
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- LLM ---
# Prefer xAI Grok 4.5 when XAI_API_KEY is set (Responses API).
# Otherwise fall back to Clawd free mesh (OpenAI-compatible chat completions).
#
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_STORE_MESSAGES=false
# XAI_TIMEOUT_SECS=600
# CLAWD_LLM_API=responses          # or: chat
# CLAWD_LLM_PROVIDER=xai           # or: mesh (force)
#
# Clawd free mesh fallback:
CLAWD_MESH_BASE_URL=https://clawd-inference-mesh.fly.dev/v1
CLAWD_MESH_MODEL=zkrouter/auto
# CLAWD_MESH_API_KEY=clawd-mesh

# --- Only if KIT_AUTH_MODE=privy ---
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Optional ---
# PERPS_MODE=paper
# CLAWD_ENV_FILE=
